@model IReadOnlyList<AdvisorClassStudentViewRow>
@{
    ViewData["Title"] = "Lớp cố vấn";
    ViewData["PageTitle"] = "Danh sách sinh viên lớp cố vấn";
    ViewData["PageSubtitle"] = "Theo dõi tình trạng học tập, GPA tích lũy và mức cảnh báo học vụ";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Sinh viên thuộc lớp cố vấn</span>
        <span class="badge-soft-blue">@Model.Count sinh viên</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr><th>Lớp</th><th>MSSV</th><th>Họ và tên</th><th>Trạng thái</th><th>Tín chỉ</th><th>GPA tích lũy</th><th>Mức cảnh báo</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.ClassCode</td>
                            <td class="tabular-nums">@s.StudentCode</td>
                            <td class="fw-semibold">@s.FullName</td>
                            <td><span class="badge-soft-emerald">@s.Status.ToDisplayText()</span></td>
                            <td class="tabular-nums">@s.CumulativeCredits</td>
                            <td class="tabular-nums">@s.CumulativeGpa.ToString("0.00")</td>
                            <td class="tabular-nums">@s.WarningStreak</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
