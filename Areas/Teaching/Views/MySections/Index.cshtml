@model IReadOnlyList<CourseSectionViewRow>
@{
    ViewData["Title"] = "Lớp học phần của tôi";
    ViewData["PageTitle"] = "Lớp học phần giảng dạy";
    ViewData["PageSubtitle"] = "Điểm danh, nhập điểm thành phần và xử lý đơn phúc khảo";
    var appeals = ViewBag.Appeals as IReadOnlyList<GradeAppealViewRow> ?? [];
}

@if (TempData["StatusMessage"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["ErrorMessage"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Danh sách lớp phụ trách</span>
        <span class="badge-soft-blue">@Model.Count lớp</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr><th>Mã lớp HP</th><th>Môn học</th><th>Học kỳ</th><th>Lịch</th><th>Phòng</th><th>Sĩ số</th><th>Khóa điểm</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.SectionCode</td>
                            <td>@s.CourseCode - @s.CourseName</td>
                            <td>@s.SemesterCode</td>
                            <td>Thứ @s.DayOfWeek (T@(s.StartPeriod)-@(s.EndPeriod))</td>
                            <td>@s.Room</td>
                            <td class="tabular-nums">@s.EnrolledCount / @s.Capacity</td>
                            <td><span class="@(s.IsGradeLocked ? "badge-soft-amber" : "badge-soft-emerald")">@(s.IsGradeLocked ? "Đã khóa" : "Đang mở")</span></td>
                            <td><a asp-action="Details" asp-route-id="@s.SectionId" class="btn btn-sm btn-primary">Điểm danh &amp; Nhập điểm</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Đơn phúc khảo thuộc lớp phụ trách (@appeals.Count)</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>MSSV</th><th>Lớp HP</th><th>Điểm</th><th>Lý do</th><th>Trạng thái</th><th>Xử lý</th></tr></thead>
                <tbody>
                    @foreach (var a in appeals)
                    {
                        <tr>
                            <td>@a.StudentCode - @a.FullName</td>
                            <td>@a.SectionCode</td>
                            <td>@a.TotalScore (@a.LetterGrade)</td>
                            <td>@a.Reason</td>
                            <td>@a.Status</td>
                            <td>
                                <form asp-action="ResolveAppeal" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="AppealId" value="@a.AppealId" />
                                    <select name="Status" class="form-select form-select-sm">
                                        <option value="2">Đề xuất giữ/sửa (GV)</option>
                                        <option value="4">Từ chối</option>
                                    </select>
                                    <input name="Response" class="form-control form-control-sm" placeholder="Ý kiến giảng viên..." required />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Gửi</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
