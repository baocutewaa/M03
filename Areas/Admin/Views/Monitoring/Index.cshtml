@model MonitoringDashboardViewModel
@{
    ViewData["Title"] = "Giám sát bảo mật & Nhật ký";
    ViewData["PageTitle"] = "Giám sát bảo mật & Nhật ký";
    ViewData["PageSubtitle"] = "Theo dõi sự kiện 24h, truy vết CorrelationId hai tầng và kiểm toán SQL Server";
}

@if (Model.Summary.IsRateLimitSpike)
{
    <div class="alert alert-danger fw-bold mb-3">
        CẢNH BÁO ĐỘT BIẾN DoS: Ghi nhận @Model.Summary.LiveRateLimit1m yêu cầu bị giới hạn (HTTP 429) trong 1 phút gần nhất (&gt; 100/phút).
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="sms-kpi-card h-100">
            <div>
                <div class="sms-kpi-label">CSDL / Health</div>
                <div class="fs-5 fw-bold @(Model.Summary.DatabaseHealthy ? "text-success" : "text-danger")">
                    @(Model.Summary.DatabaseHealthy ? "Healthy" : "Unhealthy")
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="sms-kpi-card h-100">
            <div>
                <div class="sms-kpi-label">ĐN thất bại (24h)</div>
                <div class="fs-4 fw-bold tabular-nums">@Model.Summary.FailedLogins24h</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="sms-kpi-card h-100">
            <div>
                <div class="sms-kpi-label">Trái phép 2001</div>
                <div class="fs-4 fw-bold tabular-nums">@Model.Summary.Unauthorized2001_24h</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="sms-kpi-card h-100">
            <div>
                <div class="sms-kpi-label">Rate limit 2003</div>
                <div class="fs-5 fw-bold tabular-nums">@Model.Summary.RateLimit2003_24h <span class="small text-muted fw-normal">(1m: @Model.Summary.LiveRateLimit1m)</span></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="sms-kpi-card h-100">
            <div>
                <div class="sms-kpi-label">Lỗi 5xx / SQL</div>
                <div class="fs-4 fw-bold tabular-nums">@Model.Summary.Errors5xx_24h</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="sms-kpi-card h-100">
            <div>
                <div class="sms-kpi-label">ĐN bất thường</div>
                <div class="fs-4 fw-bold tabular-nums">@Model.Summary.UnusualLogins24h</div>
            </div>
        </div>
    </div>
</div>

<form method="get" asp-action="Index" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label fw-semibold" for="correlationId">Đối chiếu theo CorrelationId (F9.4)</label>
            <input id="correlationId" name="correlationId" value="@Model.CorrelationIdFilter" class="form-control form-control-sm" placeholder="Nhập CorrelationId..." />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary">Lọc nhật ký</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Xóa lọc</a>
        </div>
    </div>
</form>

<div class="card mb-4">
    <div class="card-header">1. Sự kiện bảo mật &amp; lỗi gần đây (<code>SMS_Log.log.AppLogs</code>)</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Thời gian (UTC)</th>
                        <th>EventId</th>
                        <th>Level</th>
                        <th>User</th>
                        <th>IP</th>
                        <th>Path</th>
                        <th>CorrelationId</th>
                        <th>Nội dung</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.SecurityEvents)
                    {
                        <tr>
                            <td class="tabular-nums">@e.TimeStamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@e.EventId</td>
                            <td>@e.Level</td>
                            <td>@e.UserName</td>
                            <td>@e.ClientIp</td>
                            <td>@e.RequestPath</td>
                            <td><code>@e.CorrelationId</code></td>
                            <td>@e.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">2. Nhật ký đăng nhập &amp; cảnh báo bất thường (F9.5)</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Thời gian (UTC)</th>
                        <th>Tài khoản</th>
                        <th>Kết quả</th>
                        <th>Lý do</th>
                        <th>IP</th>
                        <th>Bất thường</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.LoginEvents)
                    {
                        <tr>
                            <td class="tabular-nums">@l.At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@l.UserName</td>
                            <td><span class="@(l.Succeeded ? "badge-soft-emerald" : "badge-soft-rose")">@(l.Succeeded ? "Thành công" : "Thất bại")</span></td>
                            <td>@l.FailureReason</td>
                            <td>@l.Ip</td>
                            <td><span class="@(l.IsUnusual ? "badge-soft-amber" : "text-muted small")">@(l.IsUnusual ? "Cảnh báo" : "Bình thường")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">3. ActivityLog (Ứng dụng)</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr><th>Thời gian</th><th>User</th><th>Hành động</th><th>Đối tượng</th><th>CorrelationId</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.ActivityLogs)
                            {
                                <tr>
                                    <td class="tabular-nums">@a.At.ToString("HH:mm:ss")</td>
                                    <td>@a.UserName</td>
                                    <td>@a.Action</td>
                                    <td>@a.Entity (@a.EntityKey)</td>
                                    <td><code>@a.CorrelationId</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">4. DataChangeLog (CSDL)</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr><th>Thời gian</th><th>AppUser</th><th>Thao tác</th><th>Bảng / Khóa</th><th>CorrelationId</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.DataChanges)
                            {
                                <tr>
                                    <td class="tabular-nums">@d.At.ToString("HH:mm:ss")</td>
                                    <td>@d.AppUserName</td>
                                    <td>@d.Action</td>
                                    <td>@d.TableName (@d.RecordKey)</td>
                                    <td><code>@d.CorrelationId</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">5a. Cảnh báo bảo mật CSDL (<code>audit.SecurityAlerts</code>)</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Thời gian (UTC)</th><th>Loại</th><th>Mức</th><th>Login</th><th>Chi tiết</th></tr></thead>
                        <tbody>
                            @foreach (var sa in Model.DbSecurityAlerts)
                            {
                                <tr>
                                    <td class="tabular-nums">@sa.DetectedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@sa.AlertType</td>
                                    <td>@sa.Severity</td>
                                    <td>@sa.TargetLogin</td>
                                    <td>@sa.Details</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">5b. Logon Trigger (<code>sec.LoginEventLog</code>)</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Thời gian</th><th>Login</th><th>Host / App</th><th>IP</th><th>Kết quả</th></tr></thead>
                        <tbody>
                            @foreach (var le in Model.SqlLoginEvents)
                            {
                                <tr>
                                    <td class="tabular-nums">@le.EventTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@le.LoginName</td>
                                    <td>@le.HostName / @le.AppName</td>
                                    <td>@le.ClientIp</td>
                                    <td><span class="@(le.Allowed ? "badge-soft-emerald" : "badge-soft-rose")">@(le.Allowed ? "Cho phép" : "Từ chối")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">6. Kho lưu trữ SQL Server Audit (<code>audit.AuditFileArchive</code>)</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr><th>Thời gian (UTC)</th><th>Action</th><th>OK</th><th>Login</th><th>Đối tượng</th><th>Câu lệnh</th></tr>
                </thead>
                <tbody>
                    @foreach (var ar in Model.SqlAuditArchives)
                    {
                        <tr>
                            <td class="tabular-nums">@ar.EventTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@ar.ActionId</td>
                            <td>@(ar.Succeeded ? "1" : "0")</td>
                            <td>@ar.ServerPrincipalName</td>
                            <td>@ar.ObjectName</td>
                            <td><code>@ar.StatementText</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
