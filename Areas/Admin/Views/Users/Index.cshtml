@model IReadOnlyList<AdminUserSummaryRow>
@{
    ViewData["Title"] = "Quản trị người dùng";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-3">
    <h3>Quản lý tài khoản &amp; phạm vi khoa (F9.1 - F9.3)</h3>
    <a asp-controller="Monitoring" asp-action="Index" class="btn btn-outline-primary">Bảng giám sát &amp; Nhật ký</a>
</div>

<table class="table table-bordered table-sm align-middle">
    <thead class="table-light">
        <tr>
            <th>Tài khoản</th>
            <th>Họ tên</th>
            <th>Vai trò</th>
            <th>Phạm vi khoa</th>
            <th>2FA</th>
            <th>Trạng thái</th>
            <th>Lỗi ĐN</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.UserName</td>
                <td>@u.FullName</td>
                <td>@u.Roles</td>
                <td>@u.FacultyScope</td>
                <td>@(u.TwoFactorEnabled ? "Bật" : "Tắt")</td>
                <td>@(!u.IsActive ? "Vô hiệu" : (u.LockoutEnd > DateTimeOffset.UtcNow ? "Đang khóa" : "Hoạt động"))</td>
                <td>@u.AccessFailedCount</td>
            </tr>
        }
    </tbody>
</table>
