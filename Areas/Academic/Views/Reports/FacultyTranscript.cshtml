@model FacultyTranscriptPageModel
@{
    ViewData["Title"] = "Bảng điểm toàn khoa";
    ViewData["PageTitle"] = "Báo cáo bảng điểm toàn khoa";
    ViewData["PageSubtitle"] = "Truy vấn phân trang tối ưu theo khoa và học kỳ";
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="get" asp-action="FacultyTranscript" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="facultyId">Khoa (Bắt buộc)</label>
            <select id="facultyId" name="facultyId" class="form-select form-select-sm" required>
                <option value="">-- Chọn khoa --</option>
                @foreach (var f in Model.Faculties)
                {
                    <option value="@f.FacultyId" selected="@(Model.FacultyId == f.FacultyId)">@f.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="semesterId">Học kỳ (Bắt buộc)</label>
            <select id="semesterId" name="semesterId" class="form-select form-select-sm" required>
                <option value="">-- Chọn học kỳ --</option>
                @foreach (var s in Model.Semesters)
                {
                    <option value="@s.SemesterId" selected="@(Model.SemesterId == s.SemesterId)">@s.Code - @s.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="pageSize">Số dòng (tối đa 100)</label>
            <input id="pageSize" name="pageSize" type="number" min="1" max="100" value="@Model.PageSize" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-primary w-100">Xem báo cáo</button>
        </div>
    </div>
</form>

@if (Model.FacultyId.HasValue && Model.SemesterId.HasValue)
{
    <p class="small text-muted">Tổng cộng <strong>@Model.TotalCount</strong> dòng (trang @Model.Page, tối đa @Model.PageSize dòng/trang).</p>

    <table class="table table-bordered table-sm">
        <thead class="table-light">
            <tr>
                <th>MSSV</th>
                <th>Họ tên</th>
                <th>Lớp</th>
                <th>Học phần</th>
                <th>TC</th>
                <th>Điểm TK</th>
                <th>Điểm chữ</th>
                <th>GPA HK</th>
                <th>GPA Tích lũy</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Items)
            {
                <tr>
                    <td>@row.StudentCode</td>
                    <td>@row.FullName</td>
                    <td>@row.ClassCode</td>
                    <td>@row.CourseCode - @row.CourseName</td>
                    <td>@row.Credits</td>
                    <td>@row.TotalScore</td>
                    <td>@row.LetterGrade</td>
                    <td>@row.Gpa4</td>
                    <td>@row.CumulativeGpa.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
}
