@model ReportsIndexViewModel
@{
    ViewData["Title"] = "Báo cáo & Xuất Excel";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-3">
    <h3>Báo cáo liên hệ sinh viên &amp; học vụ</h3>
    @if (User.HasClaim("perm", "Report.Export"))
    {
        <form asp-action="ExportContacts" method="post">
            <button type="submit" class="btn btn-success">Xuất Excel (.xlsx)</button>
        </form>
    }
</div>

@if (!Model.CanViewSensitive)
{
    <div class="alert alert-info">
        Bạn đang xem báo cáo ở chế độ che dữ liệu nhạy cảm (Email, SĐT) do không có quyền <code>Report.ViewSensitive</code>.
    </div>
}

<h5 class="mt-3">Danh sách liên hệ sinh viên</h5>
<table class="table table-bordered table-sm">
    <thead>
        <tr>
            <th>MSSV</th>
            <th>Họ tên</th>
            <th>Lớp</th>
            <th>Khoa</th>
            <th>Email</th>
            <th>SĐT</th>
            @if (Model.CanViewSensitive)
            {
                <th>Ngày sinh</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.CanViewSensitive)
        {
            @foreach (var row in Model.FullContacts)
            {
                <tr>
                    <td>@row.StudentCode</td>
                    <td>@row.FullName</td>
                    <td>@row.ClassCode</td>
                    <td>@row.FacultyName</td>
                    <td>@row.Email</td>
                    <td>@row.Phone</td>
                    <td>@row.DateOfBirth.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        }
        else
        {
            @foreach (var row in Model.MaskedContacts)
            {
                <tr>
                    <td>@row.StudentCode</td>
                    <td>@row.FullName</td>
                    <td>@row.ClassCode</td>
                    <td>@row.FacultyName</td>
                    <td><code>@row.MaskedEmail</code></td>
                    <td><code>@row.MaskedPhone</code></td>
                </tr>
            }
        }
    </tbody>
</table>

<h5 class="mt-4">Cảnh báo học vụ (@Model.Warnings.Count)</h5>
<table class="table table-bordered table-sm">
    <thead>
        <tr>
            <th>Học kỳ</th>
            <th>MSSV</th>
            <th>Họ tên</th>
            <th>Mức</th>
            <th>GPA HK</th>
            <th>GPA TL</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var w in Model.Warnings)
        {
            <tr>
                <td>@w.SemesterCode</td>
                <td>@w.StudentCode</td>
                <td>@w.FullName</td>
                <td>Mức @w.Level</td>
                <td>@w.SemesterGpa.ToString("0.00")</td>
                <td>@w.CumulativeGpa.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>

<h5 class="mt-4">Xét tốt nghiệp (@Model.Graduation.Count)</h5>
<table class="table table-bordered table-sm">
    <thead>
        <tr>
            <th>MSSV</th>
            <th>Họ tên</th>
            <th>Tín chỉ</th>
            <th>GPA tích lũy</th>
            <th>Đạt điều kiện</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in Model.Graduation)
        {
            <tr>
                <td>@g.StudentCode</td>
                <td>@g.FullName</td>
                <td>@g.CumulativeCredits / @g.TotalCreditsRequired</td>
                <td>@g.CumulativeGpa.ToString("0.00")</td>
                <td>@(g.IsEligible ? "Đủ điều kiện" : "Chưa đạt")</td>
            </tr>
        }
    </tbody>
</table>
