@model StudentListPageViewModel
@{
    ViewData["Title"] = "Danh sách sinh viên";
    ViewData["PageTitle"] = "Quản lý hồ sơ sinh viên";
    ViewData["PageSubtitle"] = "Tra cứu, lọc theo khoa/ngành/khóa và quản lý hồ sơ học tập";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <p class="text-muted small mb-0">Tìm thấy <strong>@Model.TotalCount</strong> sinh viên (trang @Model.EffectivePage / @Math.Max(1, Model.TotalPages), tối đa @Model.EffectivePageSize dòng/trang).</p>
    @if (User.HasClaim("perm", "Student.Create"))
    {
        <a asp-area="Academic" asp-controller="Students" asp-action="Create" class="btn btn-primary btn-sm px-3">+ Thêm sinh viên</a>
    }
</div>

@if (TempData["StatusMessage"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <input name="Keyword" value="@Model.Query.Keyword" class="form-control form-control-sm" placeholder="MSSV hoặc họ tên..." />
        </div>
        <div class="col-md-2">
            <select name="FacultyId" class="form-select form-select-sm">
                <option value="">-- Tất cả khoa --</option>
                @foreach (var f in Model.Faculties)
                {
                    <option value="@f.FacultyId" selected="@(Model.Query.FacultyId == f.FacultyId)">@f.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="MajorId" class="form-select form-select-sm">
                <option value="">-- Tất cả ngành --</option>
                @foreach (var m in Model.Majors)
                {
                    <option value="@m.MajorId" selected="@(Model.Query.MajorId == m.MajorId)">@m.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="CohortId" class="form-select form-select-sm">
                <option value="">-- Tất cả khóa --</option>
                @foreach (var c in Model.Cohorts)
                {
                    <option value="@c.CohortId" selected="@(Model.Query.CohortId == c.CohortId)">@c.Code</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="Sort" class="form-select form-select-sm">
                <option value="code" selected="@(Model.Query.Sort == "code")">Sắp xếp: MSSV</option>
                <option value="name" selected="@(Model.Query.Sort == "name")">Sắp xếp: Họ tên</option>
                <option value="admitted" selected="@(Model.Query.Sort == "admitted")">Sắp xếp: Ngày nhập học</option>
                <option value="gpa" selected="@(Model.Query.Sort == "gpa")">Sắp xếp: GPA</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-sm btn-primary w-100">Lọc</button>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>MSSV</th>
                        <th>Họ và tên</th>
                        <th>Khoa</th>
                        <th>Ngành</th>
                        <th>Lớp</th>
                        <th>GPA</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Items)
                    {
                        var statusCls = s.Status switch
                        {
                            1 => "badge-soft-emerald",
                            6 => "badge-soft-blue",
                            2 => "badge-soft-amber",
                            _ => "badge-soft-rose"
                        };
                        <tr>
                            <td class="fw-semibold tabular-nums">@s.StudentCode</td>
                            <td class="fw-semibold">@s.FullName</td>
                            <td>@s.FacultyName</td>
                            <td>@s.MajorName</td>
                            <td>@s.ClassCode</td>
                            <td class="tabular-nums">@s.CumulativeGpa.ToString("0.00")</td>
                            <td><span class="@statusCls">@s.Status.ToDisplayText()</span></td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <a asp-action="Details" asp-route-id="@s.PublicId" class="btn btn-outline-primary btn-sm">Chi tiết</a>
                                    @if (User.HasClaim("perm", "Student.Edit"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@s.PublicId" class="btn btn-outline-secondary btn-sm">Sửa</a>
                                    }
                                    <a asp-action="History" asp-route-id="@s.PublicId" class="btn btn-outline-info btn-sm">Lịch sử</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
