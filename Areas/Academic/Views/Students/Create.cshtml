@model StudentCreateInput
@{
    ViewData["Title"] = "Thêm sinh viên";
    var faculties = ViewBag.Faculties as IReadOnlyList<FacultyViewRow> ?? [];
    var majors = ViewBag.Majors as IReadOnlyList<MajorViewRow> ?? [];
    var cohorts = ViewBag.Cohorts as IReadOnlyList<CohortViewRow> ?? [];
    var classes = ViewBag.Classes as IReadOnlyList<AdminClassViewRow> ?? [];
}

<h3 class="mt-3 mb-3">Thêm hồ sơ sinh viên mới</h3>

<form asp-action="Create" method="post" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="StudentCode" class="form-label"></label>
            <input asp-for="StudentCode" class="form-control" />
            <span asp-validation-for="StudentCode" class="text-danger"></span>
        </div>
        <div class="col-md-5">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Gender" class="form-label"></label>
            <select asp-for="Gender" class="form-select">
                <option value="1">Nam</option>
                <option value="0">Nữ</option>
                <option value="2">Khác</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="DateOfBirth" class="form-label"></label>
            <input asp-for="DateOfBirth" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="NationalId" class="form-label"></label>
            <input asp-for="NationalId" class="form-control" />
            <span asp-validation-for="NationalId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="col-md-12">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="FacultyId" class="form-label"></label>
            <select asp-for="FacultyId" class="form-select">
                @foreach (var f in faculties) { <option value="@f.FacultyId">@f.Name</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="MajorId" class="form-label"></label>
            <select asp-for="MajorId" class="form-select">
                @foreach (var m in majors) { <option value="@m.MajorId">@m.Name (@m.FacultyName)</option> }
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="CohortId" class="form-label"></label>
            <select asp-for="CohortId" class="form-select">
                @foreach (var c in cohorts) { <option value="@c.CohortId">@c.Code</option> }
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="ClassId" class="form-label"></label>
            <select asp-for="ClassId" class="form-select">
                @foreach (var cl in classes) { <option value="@cl.ClassId">@cl.Code</option> }
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="AdmissionDate" class="form-label"></label>
            <input asp-for="AdmissionDate" type="date" class="form-control" />
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Tạo hồ sơ</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
