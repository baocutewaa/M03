@model StudentEditInput
@{
    ViewData["Title"] = $"Sửa hồ sơ {Model.StudentCode}";
    var faculties = ViewBag.Faculties as IReadOnlyList<FacultyViewRow> ?? [];
    var majors = ViewBag.Majors as IReadOnlyList<MajorViewRow> ?? [];
    var cohorts = ViewBag.Cohorts as IReadOnlyList<CohortViewRow> ?? [];
    var classes = ViewBag.Classes as IReadOnlyList<AdminClassViewRow> ?? [];
}

<h3 class="mt-3 mb-3">Cập nhật hồ sơ sinh viên: @Model.StudentCode</h3>

<form asp-action="Edit" asp-route-id="@Model.PublicId" method="post" class="card card-body">
    <input type="hidden" asp-for="PublicId" />
    <input type="hidden" asp-for="RowVersionBase64" />
    <input type="hidden" asp-for="StudentCode" />
    <input type="hidden" asp-for="CanViewSensitive" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Gender" class="form-label"></label>
            <select asp-for="Gender" class="form-select">
                <option value="1">Nam</option>
                <option value="0">Nữ</option>
                <option value="2">Khác</option>
            </select>
        </div>

        <div class="col-md-3">
            <label asp-for="DateOfBirth" class="form-label"></label>
            <input asp-for="DateOfBirth" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="NationalId" class="form-label"></label>
            <input asp-for="NationalId" class="form-control" placeholder="@(Model.CanViewSensitive ? "" : "Để trống để giữ nguyên")" />
            <span asp-validation-for="NationalId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="@(Model.CanViewSensitive ? "" : "Để trống để giữ nguyên")" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" placeholder="@(Model.CanViewSensitive ? "" : "Để trống để giữ nguyên")" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="col-md-12">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" placeholder="@(Model.CanViewSensitive ? "" : "Để trống để giữ nguyên")" />
        </div>

        <div class="col-md-3">
            <label asp-for="FacultyId" class="form-label">Khoa</label>
            <select asp-for="FacultyId" class="form-select">
                @foreach (var f in faculties) { <option value="@f.FacultyId">@f.Name</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="MajorId" class="form-label">Ngành</label>
            <select asp-for="MajorId" class="form-select">
                @foreach (var m in majors) { <option value="@m.MajorId">@m.Name</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="CohortId" class="form-label">Khóa</label>
            <select asp-for="CohortId" class="form-select">
                @foreach (var c in cohorts) { <option value="@c.CohortId">@c.Code</option> }
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="ClassId" class="form-label">Lớp</label>
            <select asp-for="ClassId" class="form-select">
                @foreach (var cl in classes) { <option value="@cl.ClassId">@cl.Code</option> }
            </select>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Details" asp-route-id="@Model.PublicId" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
