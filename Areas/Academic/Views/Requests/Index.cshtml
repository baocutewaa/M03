@model IReadOnlyList<StudentRequestViewRow>
@{
    ViewData["Title"] = "Xử lý yêu cầu sinh viên";
}

<h3 class="mt-3 mb-3">Yêu cầu hành chính của sinh viên</h3>

@if (TempData["StatusMessage"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<table class="table table-bordered table-sm align-middle">
    <thead>
        <tr>
            <th>MSSV</th>
            <th>Họ tên</th>
            <th>Loại</th>
            <th>Nội dung</th>
            <th>Trạng thái</th>
            <th>Phản hồi / Xử lý</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var req in Model)
        {
            var statusText = req.Status switch { 2 => "Đã duyệt", 3 => "Từ chối", _ => "Chờ xử lý" };
            <tr>
                <td>@req.StudentCode</td>
                <td>@req.FullName</td>
                <td>@req.Type</td>
                <td>@req.Content</td>
                <td>@statusText</td>
                <td>
                    @if (req.Status == 1)
                    {
                        <form asp-action="Resolve" method="post" class="d-flex gap-2">
                            <input type="hidden" name="PublicId" value="@req.PublicId" />
                            <select name="Status" class="form-select form-select-sm w-auto">
                                <option value="2">Duyệt</option>
                                <option value="3">Từ chối</option>
                            </select>
                            <input type="text" name="Response" class="form-control form-control-sm" placeholder="Nội dung phản hồi" required maxlength="1000" />
                            <button type="submit" class="btn btn-sm btn-primary">Lưu</button>
                        </form>
                    }
                    else
                    {
                        <span>@req.Response</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
