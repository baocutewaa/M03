@model IReadOnlyList<CourseSectionViewRow>
@{
    ViewData["Title"] = "Lớp học phần";
    ViewData["PageTitle"] = "Mở & Quản lý lớp học phần";
    ViewData["PageSubtitle"] = "Phân công giảng viên, thiết lập lịch học và quản lý danh sách lớp";
    var semesters = ViewBag.Semesters as IReadOnlyList<SemesterViewRow> ?? [];
    var courses = ViewBag.Courses as IReadOnlyList<CourseViewRow> ?? [];
    var lecturers = ViewBag.Lecturers as IReadOnlyList<LecturerViewRow> ?? [];
}

@if (TempData["StatusMessage"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["ErrorMessage"] is string err) { <div class="alert alert-danger">@err</div> }

<form asp-action="Save" method="post" class="card card-body mb-4">
    <div class="row g-2">
        <div class="col-md-2"><input name="Code" class="form-control form-control-sm" placeholder="Mã lớp HP" required /></div>
        <div class="col-md-2">
            <select name="SemesterId" class="form-select form-select-sm">
                @foreach (var s in semesters) { <option value="@s.SemesterId">@s.Code</option> }
            </select>
        </div>
        <div class="col-md-3">
            <select name="CourseId" class="form-select form-select-sm">
                @foreach (var c in courses) { <option value="@c.CourseId">@c.Code - @c.Name</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select name="LecturerId" class="form-select form-select-sm">
                @foreach (var l in lecturers) { <option value="@l.LecturerId">@l.FullName</option> }
            </select>
        </div>
        <div class="col-md-1"><input name="Capacity" type="number" class="form-control form-control-sm" value="50" min="1" /></div>
        <div class="col-md-2"><button type="submit" class="btn btn-sm btn-primary w-100">Mở lớp HP</button></div>
    </div>
</form>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Danh sách lớp học phần</span>
        <span class="badge-soft-blue">@Model.Count lớp</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Mã lớp HP</th><th>Môn học</th><th>Học kỳ</th><th>Giảng viên</th>
                        <th>Lịch</th><th>Phòng</th><th>Sĩ số</th><th>Khóa điểm</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.SectionCode</td>
                            <td>@s.CourseCode - @s.CourseName</td>
                            <td>@s.SemesterCode</td>
                            <td>@s.LecturerName</td>
                            <td>Thứ @s.DayOfWeek (T@(s.StartPeriod)-@(s.EndPeriod))</td>
                            <td>@s.Room</td>
                            <td class="tabular-nums">@s.EnrolledCount / @s.Capacity</td>
                            <td><span class="@(s.IsGradeLocked ? "badge-soft-amber" : "badge-soft-emerald")">@(s.IsGradeLocked ? "Đã khóa" : "Đang mở")</span></td>
                            <td><a asp-action="Roster" asp-route-id="@s.SectionId" class="btn btn-sm btn-outline-primary">Danh sách &amp; Điểm</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
