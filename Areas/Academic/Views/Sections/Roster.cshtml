@model SectionDetailViewModel
@{
    ViewData["Title"] = $"Lớp {Model.Section.SectionCode}";
    ViewData["PageTitle"] = $"Lớp học phần: {Model.Section.SectionCode}";
    ViewData["PageSubtitle"] = $"{Model.Section.CourseName} · Học kỳ {Model.Section.SemesterCode}";
}

@if (TempData["StatusMessage"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["ErrorMessage"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="mb-3 d-flex gap-2">
    @if (!Model.Section.IsGradeLocked && User.HasClaim("perm", "Grade.Finalize"))
    {
        <form asp-action="FinalizeGrades" method="post">
            <input type="hidden" name="sectionId" value="@Model.Section.SectionId" />
            <button type="submit" class="btn btn-warning btn-sm">Khóa điểm lớp học phần</button>
        </form>
    }
    @if (Model.Section.IsGradeLocked && User.HasClaim("perm", "Grade.Unlock"))
    {
        <form asp-action="UnlockGrades" method="post" class="d-flex gap-2">
            <input type="hidden" name="SectionId" value="@Model.Section.SectionId" />
            <input name="Reason" class="form-control form-control-sm" placeholder="Lý do mở khóa điểm..." required />
            <button type="submit" class="btn btn-danger btn-sm">Mở khóa điểm</button>
        </form>
    }
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Quay lại</a>
</div>

<table class="table table-bordered table-sm">
    <thead class="table-light">
        <tr><th>MSSV</th><th>Họ tên</th><th>Lớp</th><th>CC</th><th>GK</th><th>CK</th><th>Tổng</th><th>Chữ</th><th>Trạng thái</th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Roster)
        {
            <tr>
                <td>@r.StudentCode</td>
                <td>@r.FullName</td>
                <td>@r.ClassCode</td>
                <td>@r.AttendanceScore</td>
                <td>@r.MidtermScore</td>
                <td>@r.FinalScore</td>
                <td>@r.TotalScore</td>
                <td>@r.LetterGrade</td>
                <td>@(r.IsFinalized == true ? "Đã chốt" : "Tạm")</td>
            </tr>
        }
    </tbody>
</table>
