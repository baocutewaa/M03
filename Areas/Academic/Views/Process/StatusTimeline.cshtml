@model IReadOnlyList<StudentStatusTimelineViewRow>
@{
    ViewData["Title"] = "Trạng thái học tập";
    ViewData["PageTitle"] = "Dòng thời gian trạng thái học tập";
    ViewData["PageSubtitle"] = "Lịch sử biến động trạng thái và quyết định học vụ";
    var publicId = (Guid)ViewBag.StudentPublicId;
}

@if (TempData["StatusMessage"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["ErrorMessage"] is string err) { <div class="alert alert-danger">@err</div> }

@if (User.HasClaim("perm", "Student.ChangeStatus"))
{
    <form asp-action="ChangeStatus" method="post" class="card card-body mb-3">
        <input type="hidden" name="StudentPublicId" value="@publicId" />
        <div class="row g-2">
            <div class="col-md-3">
                <select name="ToStatus" class="form-select form-select-sm">
                    <option value="1">Đang học</option>
                    <option value="2">Bảo lưu</option>
                    <option value="3">Đình chỉ</option>
                    <option value="4">Thôi học</option>
                    <option value="5">Buộc thôi học</option>
                    <option value="6">Tốt nghiệp</option>
                </select>
            </div>
            <div class="col-md-2"><input name="DecisionNo" class="form-control form-control-sm" placeholder="Số quyết định" required /></div>
            <div class="col-md-2"><input name="EffectiveDate" type="date" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
            <div class="col-md-3"><input name="Reason" class="form-control form-control-sm" placeholder="Lý do..." /></div>
            <div class="col-md-2"><button type="submit" class="btn btn-sm btn-primary w-100">Đổi trạng thái</button></div>
        </div>
    </form>
}

<table class="table table-bordered table-sm">
    <thead class="table-light">
        <tr><th>Ngày hiệu lực</th><th>Từ</th><th>Sang</th><th>Số QĐ</th><th>Lý do</th><th>Người lập</th></tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.EffectiveDate.ToString("yyyy-MM-dd")</td>
                <td>@(t.FromStatus?.ToDisplayText() ?? "-")</td>
                <td>@t.ToStatus.ToDisplayText()</td>
                <td>@t.DecisionNo</td>
                <td>@t.Reason</td>
                <td>@t.CreatedBy</td>
            </tr>
        }
    </tbody>
</table>
