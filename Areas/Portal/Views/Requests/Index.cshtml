@model PortalRequestsViewModel
@{
    ViewData["Title"] = "Yêu cầu hành chính & Thông báo";
}

<h3 class="mt-3 mb-3">Yêu cầu hành chính &amp; Thông báo</h3>

@if (TempData["StatusMessage"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header fw-bold">Gửi yêu cầu hành chính</div>
            <div class="card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="Type">Loại yêu cầu</label>
                        <select id="Type" name="Type" class="form-select">
                            <option value="XacNhanSV">Giấy xác nhận sinh viên</option>
                            <option value="BangDiem">Cấp bảng điểm</option>
                            <option value="TamHoan">Tạm hoãn nghĩa vụ</option>
                            <option value="Khac">Yêu cầu khác</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="Content">Nội dung</label>
                        <textarea id="Content" name="Content" class="form-control" rows="3" maxlength="1500" required></textarea>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Gửi yêu cầu</button>
                    </div>
                </form>
            </div>
        </div>

        <h5>Danh sách yêu cầu của bạn</h5>
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th>Loại</th>
                    <th>Nội dung</th>
                    <th>Trạng thái</th>
                    <th>Phản hồi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var req in Model.Requests)
                {
                    var badge = req.Status switch { 2 => "Đã duyệt", 3 => "Từ chối", _ => "Chờ xử lý" };
                    <tr>
                        <td>@req.Type</td>
                        <td>@req.Content</td>
                        <td>@badge</td>
                        <td>@req.Response</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-6">
        <h5>Thông báo từ Nhà trường / Khoa</h5>
        @foreach (var ann in Model.Announcements)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <strong>@ann.Title</strong>
                    <span class="text-muted small ms-2">(@(ann.FacultyName ?? "Toàn trường") - @ann.PublishedAt.ToLocalTime().ToString("yyyy-MM-dd"))</span>
                </div>
                <div class="card-body">
                    @Html.Raw(ann.BodyHtml)
                </div>
            </div>
        }
    </div>
</div>
