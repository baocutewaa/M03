@model PortalProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ của tôi";
    ViewData["PageTitle"] = $"Hồ sơ sinh viên · {Model.Student.StudentCode}";
    ViewData["PageSubtitle"] = $"{Model.Student.FullName} · {Model.Student.FacultyName}";
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Thông tin học tập</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">MSSV</dt><dd class="col-sm-8 fw-semibold tabular-nums">@Model.Student.StudentCode</dd>
                    <dt class="col-sm-4 text-muted">Họ và tên</dt><dd class="col-sm-8 fw-semibold">@Model.Student.FullName</dd>
                    <dt class="col-sm-4 text-muted">Khoa / Ngành</dt><dd class="col-sm-8">@Model.Student.FacultyName / @Model.Student.MajorName</dd>
                    <dt class="col-sm-4 text-muted">Lớp / Khóa</dt><dd class="col-sm-8">@Model.Student.ClassCode / @Model.Student.CohortCode</dd>
                    <dt class="col-sm-4 text-muted">Trạng thái</dt><dd class="col-sm-8"><span class="badge-soft-emerald">@Model.Student.Status.ToDisplayText()</span></dd>
                    <dt class="col-sm-4 text-muted">Tín chỉ / GPA</dt><dd class="col-sm-8 tabular-nums fw-semibold">@Model.Student.CumulativeCredits TC · GPA @Model.Student.CumulativeGpa.ToString("0.00")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Lịch sử trạng thái</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Ngày hiệu lực</th><th>Trạng thái</th><th>Số QĐ</th></tr></thead>
                        <tbody>
                            @foreach (var h in Model.StatusTimeline)
                            {
                                <tr>
                                    <td class="tabular-nums">@h.EffectiveDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge-soft-blue">@h.ToStatus.ToDisplayText()</span></td>
                                    <td>@h.DecisionNo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Warnings.Count > 0)
{
    <div class="alert alert-warning mb-4">
        <strong>Cảnh báo học vụ:</strong>
        @string.Join("; ", Model.Warnings.Select(w => $"HK {w.SemesterCode} - Mức {w.Level} (GPA HK {w.SemesterGpa})"))
    </div>
}

@if (Model.DisciplineRewards.Count > 0)
{
    <div class="card">
        <div class="card-header">Khen thưởng &amp; Kỷ luật</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Loại</th><th>Số QĐ</th><th>Ngày</th><th>Nội dung</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.DisciplineRewards)
                        {
                            <tr>
                                <td><span class="@(d.Type == 1 ? "badge-soft-emerald" : "badge-soft-rose")">@(d.Type == 1 ? "Khen thưởng" : "Kỷ luật")</span></td>
                                <td>@d.DecisionNo</td>
                                <td class="tabular-nums">@d.DecisionDate.ToString("yyyy-MM-dd")</td>
                                <td>@d.Content</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
