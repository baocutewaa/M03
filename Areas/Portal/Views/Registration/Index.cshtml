@model PortalRegistrationViewModel
@{
    ViewData["Title"] = "Đăng ký học phần & Thời khóa biểu";
    ViewData["PageTitle"] = "Đăng ký học phần & Thời khóa biểu";
    ViewData["PageSubtitle"] = "Quản lý lớp học phần đã đăng ký và chọn lớp đang mở trong học kỳ";
}

@if (TempData["StatusMessage"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["ErrorMessage"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Lớp học phần đã đăng ký trong kỳ</span>
        <span class="badge-soft-emerald">@Model.MyEnrollments.Count lớp</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Mã lớp HP</th><th>Mã môn</th><th>Tên môn</th><th>TC</th><th>Học kỳ</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in Model.MyEnrollments)
                    {
                        <tr>
                            <td class="fw-semibold">@e.SectionCode</td>
                            <td>@e.CourseCode</td>
                            <td>@e.CourseName</td>
                            <td class="tabular-nums">@e.Credits</td>
                            <td>@e.SemesterCode</td>
                            <td>
                                <form asp-action="Drop" method="post">
                                    <input type="hidden" name="enrollmentId" value="@e.EnrollmentId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hủy ĐK</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Lớp học phần đang mở</span>
        <span class="badge-soft-blue">@Model.OpenSections.Count lớp</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Mã lớp HP</th><th>Môn học</th><th>TC</th><th>Giảng viên</th><th>Lịch</th><th>Phòng</th><th>Sĩ số</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in Model.OpenSections)
                    {
                        <tr>
                            <td class="fw-semibold">@s.SectionCode</td>
                            <td>@s.CourseCode - @s.CourseName</td>
                            <td class="tabular-nums">@s.Credits</td>
                            <td>@s.LecturerName</td>
                            <td>Thứ @s.DayOfWeek (T@(s.StartPeriod)-@(s.EndPeriod))</td>
                            <td>@s.Room</td>
                            <td class="tabular-nums">@s.EnrolledCount / @s.Capacity</td>
                            <td>
                                <form asp-action="Register" method="post">
                                    <input type="hidden" name="sectionId" value="@s.SectionId" />
                                    <button type="submit" class="btn btn-sm btn-primary">Đăng ký</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
