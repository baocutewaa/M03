@model PortalProgressViewModel
@{
    ViewData["Title"] = "Tiến độ CTĐT";
    ViewData["PageTitle"] = "Tiến độ Chương trình đào tạo";
    ViewData["PageSubtitle"] = "Theo dõi môn bắt buộc, tự chọn và tín chỉ tích lũy theo khung chương trình";
}

<div class="d-flex gap-3 flex-wrap mb-3">
    <span class="badge-soft-emerald">Tín chỉ đạt / Yêu cầu: @Model.EarnedCredits / @Model.TotalCreditsRequired</span>
    <span class="badge-soft-amber">Môn bắt buộc chưa đạt: @Model.FailedMandatoryCount</span>
</div>

<div class="card">
    <div class="card-header">Danh mục môn học theo CTĐT</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr><th>HK dự kiến</th><th>Mã môn</th><th>Tên môn</th><th>TC</th><th>Loại</th><th>Điểm cao nhất</th><th>Trạng thái</th></tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td class="tabular-nums">@i.SuggestedSemester</td>
                            <td class="fw-semibold">@i.CourseCode</td>
                            <td>@i.CourseName</td>
                            <td class="tabular-nums">@i.Credits</td>
                            <td>@(i.IsMandatory ? "Bắt buộc" : "Tự chọn")</td>
                            <td class="tabular-nums">@(i.BestScore?.ToString("0.0") ?? "-")</td>
                            <td><span class="@(i.IsPassed == 1 ? "badge-soft-emerald" : "badge-soft-amber")">@(i.IsPassed == 1 ? "Đã đạt" : "Chưa đạt")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
