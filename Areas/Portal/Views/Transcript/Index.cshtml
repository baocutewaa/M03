@model PortalTranscriptViewModel
@{
    ViewData["Title"] = "Bảng điểm cá nhân";
}

<h3 class="mt-3 mb-3">Bảng điểm cá nhân</h3>

@if (TempData["StatusMessage"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["ErrorMessage"] is string err) { <div class="alert alert-danger">@err</div> }

<p><strong>Tín chỉ tích lũy:</strong> @Model.PassedCredits · <strong>GPA tích lũy (hệ 4):</strong> @Model.CumulativeGpa.ToString("0.00")</p>

<table class="table table-bordered table-sm mb-4">
    <thead class="table-light">
        <tr><th>Học kỳ</th><th>Mã môn</th><th>Tên môn</th><th>TC</th><th>CC</th><th>GK</th><th>CK</th><th>Tổng</th><th>Chữ</th><th>Hệ 4</th><th>Phúc khảo</th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.SemesterCode</td><td>@r.CourseCode</td><td>@r.CourseName</td><td>@r.Credits</td>
                <td>@r.AttendanceScore</td><td>@r.MidtermScore</td><td>@r.FinalScore</td>
                <td>@r.TotalScore</td><td>@r.LetterGrade</td><td>@r.Gpa4</td>
                <td>
                    @if (r.IsFinalized == true)
                    {
                        <form asp-action="SubmitAppeal" method="post" class="d-flex gap-1">
                            <input type="hidden" name="EnrollmentId" value="@r.EnrollmentId" />
                            <input name="Reason" class="form-control form-control-sm" placeholder="Lý do phúc khảo..." required />
                            <button type="submit" class="btn btn-sm btn-outline-warning">Gửi</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">Chưa chốt</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.MyAppeals.Count > 0)
{
    <h5>Đơn phúc khảo của tôi</h5>
    <table class="table table-bordered table-sm">
        <thead><tr><th>Học phần</th><th>Lý do</th><th>Trạng thái</th><th>Phản hồi</th></tr></thead>
        <tbody>
            @foreach (var a in Model.MyAppeals)
            {
                <tr><td>@a.CourseCode (@a.SectionCode)</td><td>@a.Reason</td><td>@a.Status</td><td>@a.Response</td></tr>
            }
        </tbody>
    </table>
}
