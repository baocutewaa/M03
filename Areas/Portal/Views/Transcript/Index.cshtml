@model PortalTranscriptViewModel
@{
    ViewData["Title"] = "Bảng điểm cá nhân";
    ViewData["PageTitle"] = "Bảng điểm cá nhân";
    ViewData["PageSubtitle"] = "Theo dõi điểm thành phần, GPA tích lũy và gửi đơn phúc khảo";
}

@if (TempData["StatusMessage"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["ErrorMessage"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="d-flex gap-3 flex-wrap mb-3">
    <span class="badge-soft-emerald">Tín chỉ tích lũy: @Model.PassedCredits</span>
    <span class="badge-soft-blue">GPA tích lũy (hệ 4): @Model.CumulativeGpa.ToString("0.00")</span>
</div>

<div class="card mb-4">
    <div class="card-header">Chi tiết điểm học phần</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr><th>Học kỳ</th><th>Mã môn</th><th>Tên môn</th><th>TC</th><th>CC</th><th>GK</th><th>CK</th><th>Tổng</th><th>Chữ</th><th>Hệ 4</th><th>Phúc khảo</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>@r.SemesterCode</td>
                            <td class="fw-semibold">@r.CourseCode</td>
                            <td>@r.CourseName</td>
                            <td class="tabular-nums">@r.Credits</td>
                            <td class="tabular-nums">@r.AttendanceScore</td>
                            <td class="tabular-nums">@r.MidtermScore</td>
                            <td class="tabular-nums">@r.FinalScore</td>
                            <td class="fw-semibold tabular-nums">@r.TotalScore</td>
                            <td>@if (!string.IsNullOrEmpty(r.LetterGrade)) { <span class="badge-soft-blue">@r.LetterGrade</span> }</td>
                            <td class="tabular-nums">@r.Gpa4</td>
                            <td>
                                @if (r.IsFinalized == true)
                                {
                                    <form asp-action="SubmitAppeal" method="post" class="d-flex gap-1">
                                        <input type="hidden" name="EnrollmentId" value="@r.EnrollmentId" />
                                        <input name="Reason" class="form-control form-control-sm" placeholder="Lý do phúc khảo..." required />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Gửi</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa chốt</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.MyAppeals.Count > 0)
{
    <div class="card">
        <div class="card-header">Đơn phúc khảo của tôi</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Học phần</th><th>Lý do</th><th>Trạng thái</th><th>Phản hồi</th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.MyAppeals)
                        {
                            <tr><td>@a.CourseCode (@a.SectionCode)</td><td>@a.Reason</td><td>@a.Status</td><td>@a.Response</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
