@model IReadOnlyList<M03_Opus.Models.Account.LoginHistoryItemViewModel>
@{
    ViewData["Title"] = "Lịch sử đăng nhập của tôi";
}

<h3 class="mt-3 mb-3">Lịch sử đăng nhập của tôi</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Thời điểm (UTC)</th>
            <th>Kết quả</th>
            <th>IP</th>
            <th>Trình duyệt / Thiết bị</th>
            <th>Cảnh báo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>
                    @if (item.Succeeded)
                    {
                        <span class="badge bg-success">Thành công</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Thất bại (@item.FailureReason)</span>
                    }
                </td>
                <td>@item.Ip</td>
                <td class="text-truncate">@item.UserAgent</td>
                <td>
                    @if (item.IsUnusual)
                    {
                        <span class="badge bg-warning text-dark">Bất thường</span>
                    }
                    else
                    {
                        <span class="text-muted">Bình thường</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
