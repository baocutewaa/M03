@model M03_Opus.Models.Account.LoginInput
@{
    ViewData["Title"] = "Đăng nhập";
}

<h1 class="sms-auth-title">Đăng nhập hệ thống</h1>
<p class="sms-auth-subtitle">Sử dụng tài khoản được cấp để truy cập cổng quản lý đào tạo.</p>

<form asp-action="Login" method="post" data-single-submit="true">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="UserName" class="form-label fw-semibold"></label>
        <input asp-for="UserName" class="form-control" autocomplete="username" placeholder="vd: staff.cntt@sms.local" />
        <span asp-validation-for="UserName" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Password" class="form-label fw-semibold"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu..." />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" data-submitting-text="Đang đăng nhập...">Đăng nhập</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
