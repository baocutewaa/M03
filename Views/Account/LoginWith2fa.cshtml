@model M03_Opus.Models.Account.LoginWith2faInput
@{
    ViewData["Title"] = "Xác thực 2 lớp (TOTP)";
}

<h1 class="sms-auth-title">Xác thực 2 lớp (TOTP)</h1>
<p class="sms-auth-subtitle">Nhập mã 6 chữ số từ ứng dụng Authenticator để hoàn tất đăng nhập.</p>

<form asp-action="LoginWith2fa" method="post" data-single-submit="true">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-4">
        <label asp-for="TwoFactorCode" class="form-label fw-semibold"></label>
        <input asp-for="TwoFactorCode" class="form-control" autocomplete="one-time-code" placeholder="000 000" />
        <span asp-validation-for="TwoFactorCode" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" data-submitting-text="Đang xác nhận...">Xác nhận mã</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
