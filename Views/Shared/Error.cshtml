@model ErrorViewModel
@{
    ViewData["Title"] = "Thông báo hệ thống";
}

<div class="alert alert-warning mt-4">
    <h4 class="alert-heading">Lỗi @Model.StatusCode</h4>
    <p>@Model.Message</p>
    @if (Model.ShowRequestId)
    {
        <p class="mb-0">
            <strong>Mã sự cố:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
<a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Quay lại trang chủ</a>
